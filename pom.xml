<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>myweb3_java</artifactId>
    <version>1.1.2-SNAPSHOT</version>

    <scm>
        <connection>scm:git:https://github.com/EthanOK/java-solidity-web3j.git</connection>
        <developerConnection>scm:git:https://github.com/EthanOK/java-solidity-web3j.git</developerConnection>
        <url>https://github.com/EthanOK/java-solidity-web3j</url>
      <tag>myweb3_java-1.1.1</tag>
  </scm>

    <properties>
        <maven.compiler.source>18</maven.compiler.source>
        <maven.compiler.target>18</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <formatter-maven-plugin.version>2.24.1</formatter-maven-plugin.version>
    </properties>
    <dependencies>

        <dependency>
            <groupId>com.okx</groupId>
            <artifactId>x402-java-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>core</artifactId>
            <version>4.12.3</version>

        </dependency>
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>2.3.2</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.web3j/web3j-sokt -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20230227</version>
        </dependency>

        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.4</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.sol4k</groupId>
            <artifactId>sol4k</artifactId>
            <version>0.4.1</version>
        </dependency>


        <dependency>
            <groupId>net.osslabz</groupId>
            <artifactId>evm-abi-decoder</artifactId>
            <version>0.1.2</version>
        </dependency>

        <!-- JUnit 5 for unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <repositories>
        <!-- Maven Central mirrors (useful when repo.maven.apache.org is unreachable/timeouts) -->
        <repository>
            <id>central-repo1</id>
            <name>Maven Central (repo1)</name>
            <url>https://repo1.maven.org/maven2/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>central-aliyun</id>
            <name>Maven Central (Aliyun mirror)</name>
            <url>https://maven.aliyun.com/repository/central</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>consensys</id>
            <url>https://dl.cloudsmith.io/public/consensys/maven/maven/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>net.revelc.code.formatter</groupId>
                    <artifactId>formatter-maven-plugin</artifactId>
                    <version>${formatter-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.web3j</groupId>
                    <artifactId>web3j-maven-plugin</artifactId>
                    <version>4.12.3</version>
                    <configuration>
                        <soliditySourceFiles />
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <configuration>
                    <!-- Generated / vendored web3j wrappers under src/main/java/org/web3j -->
                    <excludes>
                        <exclude>org/web3j/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>